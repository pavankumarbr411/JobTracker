<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FC"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Branding -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JOBTRACKER"
            android:textColor="#7652C8"
            android:textSize="13sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />

        <!-- Page heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Add a job application"
            android:textColor="#28213D"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Keep every opportunity organized in one place."
            android:textColor="#716B80"
            android:textSize="15sp" />

        <!-- Form card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/job_card_background"
            android:elevation="2dp">

            <!-- Company -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Company name *"
                android:textColor="#302944"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editCompany"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#9B82DC"
                android:hint="e.g. Volvo"
                android:inputType="textCapWords"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#28213D"
                android:textColorHint="#9690A3"
                android:textSize="15sp" />

            <!-- Job title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Job title *"
                android:textColor="#302944"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editJobTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#9B82DC"
                android:hint="e.g. Graduate Engineer Trainee"
                android:inputType="textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#28213D"
                android:textColorHint="#9690A3"
                android:textSize="15sp" />

            <!-- Location -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Location"
                android:textColor="#302944"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editLocation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#9B82DC"
                android:hint="e.g. Bengaluru"
                android:inputType="textCapWords"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#28213D"
                android:textColorHint="#9690A3"
                android:textSize="15sp" />

            <!-- Status -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Application status"
                android:textColor="#302944"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#9B82DC"
                android:entries="@array/job_statuses"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- Job URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Job posting URL (optional)"
                android:textColor="#302944"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editJobUrl"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#9B82DC"
                android:hint="https://..."
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#28213D"
                android:textColorHint="#9690A3"
                android:textSize="15sp" />

            <!-- Save button -->
            <Button
                android:id="@+id/btnSaveJob"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#805AD5"
                android:text="Save Application"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Cancel button -->
            <Button
                android:id="@+id/btnCancelJob"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#F0EBFA"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#6746AC"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Your next opportunity starts here."
            android:textColor="#8B8498"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
